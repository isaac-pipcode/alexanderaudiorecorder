# ─────────────────────────────────────────────────────────────
# Spotify (aba Spotify) — fluxo PKCE, NÃO precisa de client secret.
# Crie um app em https://developer.spotify.com/dashboard
# e adicione a Redirect URI: https://SEU-DOMINIO.vercel.app/spotify
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=seu_client_id_aqui

# ─────────────────────────────────────────────────────────────
# YouTube (aba YouTube) — URL do backend que roda yt-dlp + ffmpeg.
# Esse backend NÃO roda no Vercel; deploye em Railway/Fly/VPS (ver backend/).
# Ex.: https://meu-backend.up.railway.app
# Se vazio, a aba YouTube mostra instruções em vez de processar.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_YOUTUBE_API_URL=
